# Weather uses Open-Meteo and does not need an API key.

# Optional official IMD climate profile.
# IMD cityforecast currently requires an API key plus JWT token.
# Example endpoint: https://api.imd.gov.in/api/v1/cityforecast?id=42182
IMD_API_KEY=your_imd_api_key_here
IMD_JWT_TOKEN=your_imd_jwt_token_here
IMD_CITYFORECAST_ID=42182

# Get a free key from https://newsdata.io/register
NEWSDATA_API_KEY=your_newsdata_api_key_here
